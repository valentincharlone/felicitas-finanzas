# Supabase (Project Settings > API). La service role key NUNCA va con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Clave del cron diario /api/keep-alive (evita que Supabase gratis se pause).
# String aleatorio de 16+ caracteres; Vercel la manda sola en el header Authorization.
CRON_SECRET=

# Resend (resend.com > API Keys)
RESEND_API_KEY=
# A dónde llegan los avisos de nuevas consultas
LEAD_NOTIFY_EMAIL=
# Remitente. Hasta verificar el dominio en Resend, dejá el de prueba.
LEAD_FROM_EMAIL="Formulario web <onboarding@resend.dev>"
